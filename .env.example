# is-sms (Next.js): environment variables. Copy to .env.local for local work; placeholders only, never real values.
# NEXT_PUBLIC_* values are built into the browser bundle: never put a secret in one.
# Value after "=" is the default when the variable is not set; "<...>" means there is no default.

# ---------------------------------------------------------------------------------------------------------------
# SMS backend (is-rest-api)
# ---------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080   # SMS origin, no trailing slash
BACKEND_BASE_URL=                                    # server-only override of the above for server-side calls
NEXT_PUBLIC_USE_LOCAL_PROXY=false                    # true: unmatched paths are proxied to SMS (local dev only)
APP_ORIGIN=http://localhost:3000                     # this app's own origin, used in local-proxy mode
NEXT_PUBLIC_SCHOOL_ID=international-schooling       # school for the routes that carry none in the URL
NEXT_PUBLIC_DEPLOYMENT_MODE=DEV                      # DEV | UAT | PROD (UAT backend switcher, analytics)

# ---------------------------------------------------------------------------------------------------------------
# Sign-in with SMS tokens (SMS plan sections 27 and 30)
# ---------------------------------------------------------------------------------------------------------------
SMS_TOKEN_ISSUER=is-sms                              # must equal SMS AUTH_TOKEN_ISSUER
SMS_TOKEN_AUDIENCE=is-sms-api                        # must equal SMS AUTH_TOKEN_AUDIENCE
# This server's key for SMS (sent as X-Service-Key on calls made before sign-in). Server-only: never NEXT_PUBLIC_.
# Must be the secret of an is-sms-YYYY-MM-DD entry in SMS AUTH_SERVICE_KEYS. Rotate every 30 days.
SMS_SERVICE_KEY=<secret, 32+ characters>
NEXT_PUBLIC_COOKIE_DOMAIN=                           # only for a host the cookie domain cannot be inferred from

# ---------------------------------------------------------------------------------------------------------------
# reCAPTCHA (public online signup, PROD only)
# ---------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<site key>
RECAPTCHA_SECRET_KEY=<secret key>                    # server-only
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_BYPASS=false                               # true withholds the site key (kill switch)
NEXT_PUBLIC_CATPCHA_COLOR=2563eb

# ---------------------------------------------------------------------------------------------------------------
# Leads API and analytics
# ---------------------------------------------------------------------------------------------------------------
NEXT_PUBLIC_LEADS_API_URL=                           # overrides the local / live leadapi host
NEXT_PUBLIC_GTM_ID=<GTM container id>
NEXT_PUBLIC_CLARITY_ID=<Clarity project id>
NEXT_PUBLIC_FB_PIXEL_ID=<Meta pixel id>

# No longer used (sign-in is SMS token cookies; next-auth was removed): NEXTAUTH_SECRET, AUTH_TRUST_HOST.
# NEXTAUTH_URL is still read as the old name of APP_ORIGIN.
