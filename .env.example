# Copy to .env (or .env.local) and fill in. Never commit real secrets.

# --- Backend (is-rest-api) -------------------------------------------------
# Spring Boot origin, e.g. https://uat.example.org or http://localhost:8080
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080
# Optional: origin the Next.js SERVER uses for Server Actions / route handlers.
# Unset = NEXT_PUBLIC_BACKEND_BASE_URL (or NEXTAUTH_URL when the local proxy is on).
# BACKEND_BASE_URL=http://localhost:8080
# true = next.config.mjs rewrites backend paths through this app (same-origin
# session cookie for captcha/login in local dev). false in production.
NEXT_PUBLIC_USE_LOCAL_PROXY=true

# Fallback school slug for the unprefixed /common/* routes
NEXT_PUBLIC_SCHOOL_ID=international-schooling

# --- Auth (next-auth v5) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Cookies ---------------------------------------------------------------
# Optional override for the campaign/UTM cookie domain (normally inferred from the host)
# NEXT_PUBLIC_COOKIE_DOMAIN=.example.org

# --- UI --------------------------------------------------------------------
# Captcha background colour (hex, no #)
NEXT_PUBLIC_CATPCHA_COLOR=cfe7ff
# Not read by the app at the moment; kept for parity with existing environments
NEXT_PUBLIC_THEME_PRIMARY_COLOR=007fff

# --- Analytics (loaded only when NEXT_PUBLIC_DEPLOYMENT_MODE=PROD) ----------
# DEV | UAT | PROD
NEXT_PUBLIC_DEPLOYMENT_MODE=DEV
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# --- reCAPTCHA (not read by the app at the moment) -------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- AI Course Advisor -----------------------------------------------------
# Nothing here: the advisor's on/off switches, Anthropic key, model and
# workspace id all live in is-rest-api's SETTINGS table
# (see docs/ai-course-advisor-rollout.md).
